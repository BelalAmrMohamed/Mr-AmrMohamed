# This is how the api keys look like in the actual `.env.local` and on Vercel Environment Variables

# Google API Keys
PUBLIC_ASSISTANT_GEMINI_API_KEYS=key_1,key_2,key_3

# Created by Vercel CLI
VERCEL_OIDC_TOKEN="many_letters"

# Supabase Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_service_role_key
