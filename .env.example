# This is how the api keys look like in the actual `.env.local` and on Vercel Environment Variables

# Google API Keys
PUBLIC_ASSISTANT_GEMINI_API_KEYS=key_1,key_2,key_3

# Created by Vercel CLI
VERCEL_OIDC_TOKEN="many_letters"

# Supabase Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_service_role_key

# Server-only Supabase key for the admin dashboard (api/admin/*, api/track.js,
# api/event.js, api/public-config.js). This is the SERVICE ROLE key from
# Supabase > Project Settings > API — it bypasses RLS, so it must only ever
# be used server-side and must NEVER be prefixed with NEXT_PUBLIC_ or shipped
# to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# The admin dashboard signs in with Google via Supabase Auth — no password of
# ours is stored anywhere, so there's nothing to set here for that. Enable
# the Google provider in Supabase (Authentication > Sign In / Providers) and
# list allowed admins in the admin_emails table (see
# docs/admin-dashboard-setup.md). Changing a Google password never touches
# this project.

# Used to authorize the scheduled cleanup job (see vercel.json "crons")
# that clears stale "live visitor" heartbeats.
CRON_SECRET=generate_a_long_random_string
