# This is how the api keys look like in the actual `.env.local` and on Vercel Environment Variables

# Google API Keys
PUBLIC_ASSISTANT_GEMINI_API_KEYS=key_1,key_2,key_3

# Created by Vercel CLI
VERCEL_OIDC_TOKEN="many_letters"

# Supabase Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_service_role_key

# Server-only Supabase key for the admin dashboard (api/admin/*, api/track.js, api/event.js).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# One-time secret used to create/reset the teacher's admin login via
# POST /api/admin/setup. Generate a long random value, set it in Vercel,
# call the endpoint once, then you can leave it set (or remove it — only
# needed again if you want to reset the password).
ADMIN_SETUP_SECRET=generate_a_long_random_string

# Used to authorize the scheduled cleanup job (see vercel.json "crons")
# that clears expired admin sessions and stale "live visitor" heartbeats.
CRON_SECRET=generate_a_long_random_string
